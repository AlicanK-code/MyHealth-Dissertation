<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Appointment Scheduling" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
      <DatePicker fx:id="datePicker" promptText="Select Date"/> <!-- Calender popup -->
      <ComboBox fx:id="timeSlots" promptText="Select Time"/> <!-- Drop down menu and time selection -->
      <Button fx:id="bookButton" text="Book Appointment" onAction="#handleBookAppointment"/>
      <Button fx:id="cancelButton" text="Cancel Appointment" onAction="#handleCancelAppointment"/>
      
      <Button fx:id="mainMenuButton" text="Return Home" onAction="#handleBackToHome"/> 

      
   </children>
</VBox>